params.reads           = null
params.sra_id          = null
params.reference       = null
params.threads         = 4
params.output_dir      = "results"
params.local_conda_env = null

includeConfig 'conf/base.config'

profiles {
    local {
        process.executor = 'local'
        process {
            beforeScript = { params.local_conda_env ? "eval \"\$(conda shell.bash hook)\" && conda activate ${params.local_conda_env}" : "eval \"\$(conda shell.bash hook)\" && conda activate bioinf-pipeline" }
            withLabel: 'process_low' {
                cpus   = 2
                memory = 4.GB
                time   = 1.h
            }
            withLabel: 'process_medium' {
                cpus   = params.threads
                memory = 8.GB
                time   = 2.h
            }
            withLabel: 'process_high' {
                cpus   = params.threads
                memory = 8.GB
                time   = 4.h
            }
        }
    }

    cluster {
        process.executor = 'slurm'
        process {
            beforeScript = 'eval "$(conda shell.bash hook)" && conda activate bioinf-pipeline'
            withLabel: 'process_low' {
                cpus   = 2
                memory = 8.GB
                time   = 1.h
                queue  = 'short'
            }
            withLabel: 'process_medium' {
                cpus   = params.threads
                memory = 8.GB
                time   = 4.h
                queue  = 'normal'
            }
            withLabel: 'process_high' {
                cpus   = params.threads
                memory = 16.GB
                time   = 8.h
                queue  = 'long'
            }
        }
    }

    container {
        docker.enabled          = true
        singularity.enabled     = false
        docker.runOptions       = '-u \$(id -u):\$(id -g)'
        process {
            withLabel: 'process_low' {
                cpus   = 2
                memory = 4.GB
                time   = 1.h
            }
            withLabel: 'process_medium' {
                cpus   = params.threads
                memory = 8.GB
                time   = 2.h
            }
            withLabel: 'process_high' {
                cpus   = params.threads
                memory = 8.GB
                time   = 4.h
            }
            withName: 'FASTQC|TRIM_READS' {
                container = 'danilazol/bioinf-qc:latest'
            }
            withName: 'ASSEMBLE' {
                container = 'danilazol/bioinf-assembly:latest'
            }
            withName: 'INDEX_REFERENCE|MAP_READS' {
                container = 'danilazol/bioinf-mapping:latest'
            }
            withName: 'BCFTOOLS_MPILEUP|BCFTOOLS_CALL' {
                container = 'danilazol/bioinf-variant:latest'
            }
            withName: 'PLOT_COVERAGE' {
                container = 'danilazol/bioinf-plot:latest'
            }
        }
    }

    singularity {
        singularity.enabled = true
        docker.enabled      = false
        singularity.runOptions = '--bind \$HOME'
        process.container = 'docker://biocontainers/biocontainers:latest'
    }
}
